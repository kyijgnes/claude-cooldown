<?xml version="1.0" encoding="utf-8"?>
<!-- 옵션 — PC 연결과 표시 설정. 홈에서 뺀 것들이 다 여기 있다.
     ★ PC 연결이 맨 위다. 연결이 안 돼 있으면 나머지는 다 소용이 없다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="옵션"
            android:textColor="@color/title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pair_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/label"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="url"
            android:background="@color/track"
            android:hint="서버 주소"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="@color/title"
            android:textColorHint="@color/faint"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:background="@color/track"
            android:hint="키 (32자리)"
            android:inputType="textNoSuggestions"
            android:maxLength="32"
            android:padding="12dp"
            android:textColor="@color/title"
            android:textColorHint="@color/faint"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/scan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PC 화면 QR 찍기"
                android:textColor="@color/title" />

            <Button
                android:id="@+id/save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="저장"
                android:textColor="@color/title" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="@color/line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="어디에 보일지"
            android:textColor="@color/label"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/notify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="상태바 · 잠금화면 · AOD"
            android:textColor="@color/title"
            android:textSize="15sp" />

        <!-- 어디에 넣을지 두 갈래. 예전엔 '배경화면으로 설정'과 '배경화면 꾸미기'가 따로 있어
             둘이 뭐가 다른지 알 수 없었다 — 배경화면 쪽은 꾸미기 화면 하나로 합쳤다. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="어디에 넣을지"
            android:textColor="@color/label"
            android:textSize="13sp" />

        <Button
            android:id="@+id/wallpaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="배경화면에 넣기"
            android:textColor="@color/title" />

        <Button
            android:id="@+id/widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="홈 화면에 위젯 넣기"
            android:textColor="@color/title" />

        <!-- 클로드 코드 원격 — PC 위젯이 `claude rc` 를 들고 있어야 폰에서 새 세션이 열린다.
             켜고 끄는 것을 여기서 한다. **설명 문단은 넣지 않는다** — 지금 상태를
             바로 아래 줄에 그대로 보여 주는 것이 설명을 대신한다(폴더 전체 규칙). -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="@color/line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="클로드 코드 원격"
            android:textColor="@color/label"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/remote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="이 PC 에서 세션 열기"
            android:textColor="@color/title"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/remote_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="확인 중…"
            android:textColor="@color/label"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>

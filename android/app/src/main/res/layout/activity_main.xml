<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 — **지금 값만** 본다. 설정·PC 연결은 전부 [옵션] 안으로 들어갔다.
     PC 가 연결 안 돼 있으면 [PC 연결하기] 가 대신 나와서 그것부터 하게 된다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- 제목 옆에 클로디가 산다. 아주 오래 꾹 누르면 공룡으로 변신해 아래 게이지 자리가
             공룡 점프 판이 된다(홈 화면 배경화면에서는 런처가 길게 누르기를 채 가서 여기서 한다). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.kyijgnes.cooldown.ClaudiView
                android:id="@+id/claudi"
                android:layout_width="96dp"
                android:layout_height="64dp" />
        </LinearLayout>

        <!-- 지금 값. 위젯·배경화면과 같은 그림을 그대로 쓴다 (GaugeRenderer).
             공룡 점프 중에는 이 자리(stage)에 판이 얹힌다. -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/gauge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/faint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PC 연결하기"
            android:textColor="@color/title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="지금 새로고침"
            android:textColor="@color/title" />

        <Button
            android:id="@+id/options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="옵션"
            android:textColor="@color/title" />
    </LinearLayout>
</ScrollView>

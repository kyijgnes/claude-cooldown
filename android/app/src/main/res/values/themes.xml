<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- appcompat 없이 간다. 색은 전부 우리 팔레트(@color/*)를 화면에서 직접 지정하므로
         부모 테마의 밝기 종류는 따지지 않는다 — 제목표시줄만 없앤다. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>

        <!-- ★ 상태바를 밝은 색으로 칠했으면 이걸 켜야 시계·배터리 글씨가 **검게** 바뀐다.
             안 켜면 흰 글씨가 흰 바탕에 얹혀 통째로 안 보인다. 어둡게는 values-night 에서 끈다. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>

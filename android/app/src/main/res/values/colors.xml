<?xml version="1.0" encoding="utf-8"?>
<!-- 밝게 — '상어' 파란 테마. 어둡게는 values-night/colors.xml.
     흐린 글자도 배경 대비 4.5:1 이상 — 위계는 밝기가 아니라 글자 크기로 준다.
     새 색을 넣을 때는 두 벌 다 채울 것. -->
<resources>
    <color name="bg">#eaf2fb</color>
    <color name="title">#0c1b2a</color>
    <color name="label">#3f5b74</color>
    <color name="sub">#274156</color>
    <color name="faint">#42607a</color>
    <color name="track">#cfe0f0</color>
    <color name="line">#d8e6f3</color>
    <color name="green">#1a7f37</color>
    <color name="amber">#8a6100</color>
    <color name="red">#cf222e</color>

    <!-- 홈 위젯 뒷판 — 반투명(65%)이라 배경화면이 비친다. GaugeRenderer.plate 와 같은 값 -->
    <color name="widget_plate">#a6eaf2fb</color>

    <!-- 마스코트 액센트 — 상어 몸통색. 밝게/어둡게 양쪽에서 그대로 쓴다 -->
    <color name="coral">#7cb0dd</color>

    <!-- 상어 배경화면 팔레트 — 폰 테마 원본 실측값. 바다는 단색이다(위아래 같은 색) -->
    <color name="sea_top">#bbd8f3</color>
    <color name="sea_bottom">#bbd8f3</color>
    <color name="shark_tint">#ffffff</color>   <!-- 곱하기 필터. 흰색이면 그림 그대로 -->
    <color name="bubble">#ffffff</color>
    <!-- 원본 실측은 #97bfdd @70% 인데, 곁에 아무것도 없는 화면에선 그 값이 너무 도드라진다 -->
    <color name="shark_shadow">#6e97bfdd</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- 클로디 — 데스크탑 위젯 슬림 바에 사는 클로드 별빛 마스코트(`windows/skins/slim.py`).

     생김새(별빛 + 통통한 몸통 + 눈)는 그대로 가져오되 **아이콘 크기에 맞게 다시 잡았다**:
     · 데스크탑은 지름 20px 라 몸통이 크고 살이 짧아도 반짝임으로 읽히지만,
       아이콘만큼 커지면 그 비율이 '톱니바퀴'가 된다 → 몸통을 줄이고 살을 길게.
     · 실제로 눈에 들어오는 건 **상하좌우 네 살**뿐이라, 대각선 넷은 아예 짧은 점으로
       바꿔 반짝임처럼 보이게 했다(있는 척하는 선보다 낫다).
     · 몸통은 가로로 살짝 넓은 타원(14×13), 눈은 크게, 아래에 작은 동그란 입 — 귀엽게.

     한가운데 (54,54). 살 끝이 22~86 이라 108 판에서 실제로 보이는 가운데 72 안에 든다.
     ★ 눈·입은 흰 도형이 아니라 **evenOdd 로 뚫은 구멍**이다. 그래야 단색(monochrome)
       아이콘으로 쓰일 때도 얼굴이 남는다(흰색으로 칠하면 통째로 물들어 사라진다).
     ★ 살은 **몸통 가장자리에서 시작**한다. 가운데에서 그으면 몸통 밑을 가로지르는데,
       눈이 구멍이라 그 살이 눈으로 비쳐 나와 실눈처럼 뭉개진다. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 상하좌우 긴 살 -->
    <path
        android:pathData="M54,41 L54,22 M54,67 L54,86 M40,54 L22,54 M68,54 L86,54"
        android:strokeColor="#d97757"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <!-- 대각선은 살이 아니라 **떠 있는 반짝임 점** 넷 — 짧은 선으로 두면 팔다리처럼 보인다 -->
    <path
        android:fillColor="#d97757"
        android:pathData="M67.5,37.7 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0 z M67.5,70.3 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0 z M34.9,70.3 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0 z M34.9,37.7 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0 z" />

    <!-- 몸통 + 얼굴(구멍) — 큰 눈 두 개와 웃는 입 -->
    <path
        android:fillColor="#d97757"
        android:fillType="evenOdd"
        android:pathData="M40,54 a14,13 0 1,0 28,0 a14,13 0 1,0 -28,0 z M43.4,50 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0 z M55.8,50 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0 z M49.5,56.8 Q54,62.2 58.5,56.8 Q54,59.8 49.5,56.8 z" />
</vector>

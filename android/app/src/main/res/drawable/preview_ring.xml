<?xml version="1.0" encoding="utf-8"?>
<!-- 미리보기용 링 게이지 — 270도 바탕에 62% 만큼(167도) 채웠다.
     실제 위젯은 `GaugeRenderer.drawArc` 가 값에 맞춰 그린다. 여기는 예시 그림이라
     각도를 박아 두었고, 색만 같은 리소스를 써서 밝게/어둡게가 따라온다.
     (호는 100×100 판에서 반지름 40, 굵기 8) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- 바탕 270도: 왼쪽 아래(135도)에서 시계 방향으로 -->
    <path
        android:pathData="M21.7,78.3 A40,40 0 1,1 78.3,78.3"
        android:strokeColor="@color/track"
        android:strokeLineCap="round"
        android:strokeWidth="8" />

    <!-- 채움 167.4도(=270×0.62): 같은 자리에서 시작해 135+167.4=302.4도 자리까지.
         끝점 = (50+40cos302.4, 50+40sin302.4) = (71.4, 16.2). 180도 미만이라 large-arc=0 -->
    <path
        android:pathData="M21.7,78.3 A40,40 0 0,1 71.4,16.2"
        android:strokeColor="@color/amber"
        android:strokeLineCap="round"
        android:strokeWidth="8" />
</vector>
